{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "landingos-ds",
	"main": "./src/index.ts",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	// "triggers": {
	//   "crons": [
	//     "0 * * * *"
	//   ]
	// },
	"env": {
		/**
		 * Local / Development environment
		 */
		"dev": {
			"name": "landingos-ds-dev",
			"durable_objects": {
				"bindings": [{ "name": "FLIGHT_ROOM", "class_name": "FlightRoomDurableObject" }]
			},
			"migrations": [
				{ "tag": "flight-room-v1", "new_sqlite_classes": ["FlightRoomDurableObject"] }
			],
			"vars": {
				"CLOUDFLARE_ENV": "dev",
				"TRANSFER_CATALOG_FRESHNESS_DAYS": "30"
			},
			"unsafe": {
				"bindings": [
					{
						"name": "RATE_LIMITER",
						"type": "ratelimit",
						"namespace_id": "1001",
						"simple": { "limit": 10, "period": 60 }
					},
					{
						"name": "RATE_LIMITER_FAST",
						"type": "ratelimit",
						"namespace_id": "1099",
						"simple": { "limit": 10, "period": 10 }
					}
				]
			}
			// "kv_namespaces": [
			//   {
			//     "binding": "CACHE",
			//     "id": "eed883194c594bf8ac25811ec3d37751",
			//     "remote": true
			//   }
			// ],
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq"
			//     }
			//   ]
			// }
		},
		/**
		 * Remote / Staging environment
		 */
		"staging": {
			"routes": [
				{
					"pattern": "api-staging.landingos.app",
					"custom_domain": true
				}
			],
			"name": "landingos-ds-staging",
			"durable_objects": {
				"bindings": [{ "name": "FLIGHT_ROOM", "class_name": "FlightRoomDurableObject" }]
			},
			"migrations": [
				{ "tag": "flight-room-v1", "new_sqlite_classes": ["FlightRoomDurableObject"] }
			],
			"vars": {
				"CLOUDFLARE_ENV": "staging",
				"TRANSFER_CATALOG_FRESHNESS_DAYS": "30"
			},
			"unsafe": {
				"bindings": [
					{
						"name": "RATE_LIMITER",
						"type": "ratelimit",
						"namespace_id": "1002",
						"simple": { "limit": 10, "period": 60 }
					}
				]
			}
			// "kv_namespaces": [
			//   {
			//     "binding": "CACHE",
			//     "id": "eb683052a4dd40b3a87d212c23b36c0c",
			//     "remote": false
			//   }
			// ],
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue-stage",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue-stage",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq-stage"
			//     }
			//   ]
			// }
		},
		/**
		 * Remote / Production environment
		 */
		"production": {
			"routes": [
				{
					"pattern": "api.landingos.app",
					"custom_domain": true
				}
			],
			"name": "landingos-ds-production",
			"durable_objects": {
				"bindings": [{ "name": "FLIGHT_ROOM", "class_name": "FlightRoomDurableObject" }]
			},
			"migrations": [
				{ "tag": "flight-room-v1", "new_sqlite_classes": ["FlightRoomDurableObject"] }
			],
			"vars": {
				"CLOUDFLARE_ENV": "production",
				"TRANSFER_CATALOG_FRESHNESS_DAYS": "30"
			},
			"unsafe": {
				"bindings": [
					{
						"name": "RATE_LIMITER",
						"type": "ratelimit",
						"namespace_id": "1003",
						"simple": { "limit": 10, "period": 60 }
					}
				]
			}
			// "kv_namespaces": [
			//   {
			//     "binding": "CACHE",
			//     "id": "7688a332f25e416795f71a004b557f65",
			//     "remote": false
			//   }
			// ],
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue-prod",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue-prod",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq-prod"
			//     }
			//   ]
			// }
		}
	}
}
