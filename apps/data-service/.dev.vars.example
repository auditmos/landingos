# CLOUDFLARE_ENV is declared in wrangler.jsonc vars per env block — do not duplicate it here.

# Provider mode: fixture is local/dev only; staging/production require explicit live mode.
# Flight selection: aviationstack or aerodatabox. Other live selections are unchanged.
# Credentials are server-only. Keep every value blank in this checked-in example.
LANDINGOS_PROVIDER_MODE=
LANDINGOS_FLIGHT_PROVIDER=
LANDINGOS_PLACES_PROVIDER=
LANDINGOS_TRANSIT_PROVIDER=
AVIATIONSTACK_ACCESS_KEY=
AERODATABOX_RAPIDAPI_KEY=
GOOGLE_MAPS_API_KEY=

DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Better Auth server configuration. Use a random secret outside development.
BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=
# Cookie Domain attribute enabling cross-subdomain sessions (frontend <-> API hosts).
# Required in staging/production (e.g. .landingos.app) or browser requests to the API
# carry no session cookie. Leave blank locally — localhost works without it.
BETTER_AUTH_COOKIE_DOMAIN=

# Dedicated server-only HMAC secret for analytics actor pseudonyms (minimum 32 characters).
ANALYTICS_PSEUDONYM_SECRET=

# API token for client-side callers (paired with VITE_API_TOKEN in user-application).
API_TOKEN=

# Comma-separated list of allowed origins for CORS. Leave empty for dev (allows all).
ALLOWED_ORIGINS=

# Cloudflare Turnstile secret key — verifies the flight-lookup challenge on /flights/resolve.
# Leave blank for local dev (challenge disabled). Required in staging/production, or the
# endpoint fails closed. Same secret as user-application's TURNSTILE_SECRET_KEY.
TURNSTILE_SECRET_KEY=
