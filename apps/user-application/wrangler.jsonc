{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "landingos-ua",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	"main": "./src/server.ts",
	"services": [
		{
			"binding": "DATA_SERVICE",
			"service": "landingos-ds-dev"
		}
	],
	"env": {
		/**
		 * Local / Development environment
		 */
		"dev": {
			"name": "landingos-ua-dev",
			"vars": { "CLOUDFLARE_ENV": "dev" },
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "landingos-ds-dev"
				}
			]
		},
		/**
		 * Remote / Staging environment
		 */
		"staging": {
			"name": "landingos-ua-staging",
			"vars": { "CLOUDFLARE_ENV": "staging" },
			"routes": [
				{
					"pattern": "staging.landingos.app",
					"custom_domain": true
				}
			],
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "landingos-ds-staging"
				}
			]
		},
		/**
		 * Remote / Production environment
		 */
		"production": {
			"name": "landingos-ua-production",
			"vars": { "CLOUDFLARE_ENV": "production" },
			"routes": [
				{
					"pattern": "landingos.app",
					"custom_domain": true
				}
			],
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "landingos-ds-production"
				}
			]
		}
	}
}
