CLOUDFLARE_ENV=dev

DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=

BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=
AUTH_EMAIL_FROM=logowanie@landingos.app

# Data Service API (for client-side calls)
VITE_DATA_SERVICE_URL=

# Data Service API token — client-side header used by api-client.ts
VITE_API_TOKEN=

# Data Service API Token (for service binding)
DATA_SERVICE_API_TOKEN=

# Cloudflare Turnstile widget pair. The site key is public; the secret stays server-side.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cookie Domain attribute enabling cross-subdomain sessions (frontend <-> API hosts).
# Required in staging/production (e.g. .landingos.app) or browser requests to the API
# carry no session cookie. Leave blank locally - localhost works without it.
BETTER_AUTH_COOKIE_DOMAIN=
