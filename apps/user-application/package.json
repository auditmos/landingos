{
	"name": "user-application",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"build:staging": "vite build --mode staging && node scripts/remove-secret-artifacts.js",
		"build:production": "vite build --mode production && node scripts/remove-secret-artifacts.js",
		"e2e:serve": "vite --config e2e/vite.config.ts --host 127.0.0.1 --port 4173",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:staging": "pnpm run build:staging && wrangler deploy --env=''",
		"deploy:production": "pnpm run build:production && wrangler deploy --env=''",
		"serve": "vite preview",
		"cf-typegen": "wrangler types --env-interface BaseEnv --env dev",
		"types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-slot": "^1.3.3",
		"@repo/data-ops": "workspace:^",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/react-router-ssr-query": "^1.167.2",
		"@tanstack/react-start": "^1.168.49",
		"better-auth": "^1.7.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.575.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vite-tsconfig-paths": "^6.1.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.3",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^5.2.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"web-vitals": "^5.3.0",
		"wrangler": "^4.128.0"
	}
}
