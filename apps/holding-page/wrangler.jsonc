{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "landingos-holding",
	"compatibility_date": "2026-08-04",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	"assets": {
		"directory": "./public"
	},
	"routes": [
		{
			"pattern": "landingos.app",
			"custom_domain": true
		}
	]
}
