{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreDependencies": ["cloudflare"],
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts", "scripts/e2e-touch-init.js", "taze.config.ts"]
		},
		"apps/data-service": {
			"entry": ["src/providers/index.ts", "src/**/*.test.ts", "vitest.config.mts"],
			"vitest": { "config": [] },
			"ignore": ["src/durable-objects/**", "src/workflows/**"]
		},
		"apps/user-application": {
			"entry": ["src/routes/**/*.{ts,tsx}", "e2e/*.{js,ts,tsx}", "vite.config.ts"],
			"vite": { "config": [] },
			"ignoreDependencies": ["jsdom", "web-vitals"],
			"ignore": ["src/components/ui/**", "src/integrations/**"]
		},
		"packages/data-ops": {
			"entry": ["src/*/index.ts", "src/auth/*.ts", "config/auth.ts", "drizzle-*.config.ts"],
			"ignoreBinaries": ["dotenvx"]
		}
	}
}
